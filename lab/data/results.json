 "ledger": [
  {
   "rule": "exact_duplicate",
   "rows_before": 1067371,
   "rows_removed": 34335,
   "rows_after": 1033036,
   "pct_removed": 3.217,
   "gross_value_removed": 431716.87,
   "rationale": "Byte-identical invoice lines (same invoice, product, timestamp, quantity and price) across 5,391 invoices. Treated as double-scanned records; keeping them would inflate revenue and basket size."
  },
  {
   "rule": "routed_to_returns",
   "rows_before": 1033036,
   "rows_removed": 22497,
   "rows_after": 1010539,
   "pct_removed": 2.178,
   "gross_value_removed": -1462050.61,
   "rationale": "Cancellations and negative-quantity lines moved to fct_returns so they cannot be summed into revenue by accident."
  },
  {
   "rule": "ledger_adjustment",
   "rows_before": 1010539,
   "rows_removed": 6,
   "rows_after": 1010533,
   "pct_removed": 0.001,
   "gross_value_removed": -147614.08,
   "rationale": "A-prefixed invoices are bad-debt ledger adjustments, not trade. Six rows carrying up to -\u00a353,594 each; summing them into revenue would move the headline by more than the effect most analyses look for."
  },
  {
   "rule": "non_product_stock_code",
   "rows_before": 1010533,
   "rows_removed": 4753,
   "rows_after": 1005780,
   "pct_removed": 0.47,
   "gross_value_removed": 822506.24,
   "rationale": "Postage, manual credits, bank charges, samples, gift vouchers and test rows share the transaction table with real products but are not sales."
  },
  {
   "rule": "non_positive_price",
   "rows_before": 1005780,
   "rows_removed": 2566,
   "rows_after": 1003214,
   "pct_removed": 0.255,
   "gross_value_removed": 0.0,
   "rationale": "Zero-price lines are stock corrections ('check', '?', 'damages'); only 71 of 6,202 even carry a customer id."
  },
  {
   "rule": "missing_description",
   "rows_before": 1003214,
   "rows_removed": 0,
   "rows_after": 1003214,
   "pct_removed": 0.0,
   "gross_value_removed": 0.0,
   "rationale": "A line with no product description cannot be attributed to a product; these coincide with the manual-adjustment rows."
  },
  {
   "rule": "zero_value_return",
   "rows_before": 22497,
   "rows_removed": 3393,
   "rows_after": 19104,
   "pct_removed": 15.082,
   "gross_value_removed": 0.0,
   "rationale": "Negative-quantity lines priced at zero: stock write-offs ('damages', 'lost', 'check') rather than customer returns. Excluded from fct_returns so return *value* stays meaningful."
  }
 ],
